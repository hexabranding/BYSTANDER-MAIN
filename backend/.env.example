# Server Configuration (Defaults to 5001 to avoid conflict with macOS AirPlay Receiver on port 5000)
PORT=5001
NODE_ENV=development

# Reverse Proxy Configuration (e.g. 1 for single-hop proxy like Nginx / AWS ALB / Cloudflare)
# TRUST_PROXY=1

# Frontend Client URL (for CORS and cookie origin)
CLIENT_URL=http://localhost:5173

# MongoDB Atlas Connection URI
# Format: mongodb+srv://<username>:<password>@<cluster-address>/<database-name>?retryWrites=true&w=majority
MONGODB_URI=mongodb+srv://<username>:<password>@<cluster-url>/bystander?retryWrites=true&w=majority

# JWT & Authentication Configuration
# Mandatory 256-bit secret in production (minimum 32 characters; fails startup if missing or invalid)
# Generate via: openssl rand -base64 32
JWT_ACCESS_SECRET=your_jwt_access_secret_key_here_min_32_chars
JWT_EXPIRES_IN=7d
COOKIE_NAME=token

# OTP Verification & HMAC Configuration
# Mandatory 256-bit secret in production for HMAC-SHA256 OTP hashing (minimum 32 characters; fails startup if missing)
# Generate via: openssl rand -base64 32
OTP_HMAC_SECRET=your_otp_hmac_secret_key_here_min_32_chars

# Payment Simulation (development/test only; strictly blocked in production)
ENABLE_PAYMENT_SIMULATION=true

# Database Seeding Configuration (used only by 'npm run seed')
# Explicit authorization flag required to prevent accidental execution
# ALLOW_SEED=true
# ADMIN_EMAIL=admin@caremate.in
# ADMIN_PASSWORD=your_secure_admin_password_min_8_chars
# ADMIN_NAME=Operations Administrator
# ADMIN_PHONE=+919811100022
# DEMO_USER_PASSWORD=your_demo_password_min_6_chars
# DEMO_CUSTOMER_EMAIL=priya.sharma@example.com
# DEMO_CAREGIVER_EMAIL=ananya.deshmukh@example.com
