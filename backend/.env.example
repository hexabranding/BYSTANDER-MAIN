# Server Configuration
PORT=5000
NODE_ENV=development

# Frontend Client URL (for CORS and cookie origin)
CLIENT_URL=http://localhost:5173

# MongoDB Atlas Connection URI
# Format: mongodb+srv://<username>:<password>@<cluster-address>/<database-name>?retryWrites=true&w=majority
MONGODB_URI=mongodb+srv://<username>:<password>@<cluster-url>/bystander?retryWrites=true&w=majority

# JWT & Authentication Configuration
# Generate a cryptographically secure 256-bit secret for production (e.g., openssl rand -base64 32)
JWT_ACCESS_SECRET=your_jwt_access_secret_key_here_min_32_chars
JWT_EXPIRES_IN=7d
COOKIE_NAME=token

# OTP Verification & HMAC Configuration
# Dedicated 256-bit secret for HMAC-SHA256 OTP hashing (minimum 32 characters in production)
# Generate via: openssl rand -base64 32
OTP_HMAC_SECRET=your_otp_hmac_secret_key_here_min_32_chars

