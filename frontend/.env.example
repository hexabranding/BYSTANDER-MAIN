# ==============================================================================
# BYSTANDER Frontend - Environment Configuration Example
# ==============================================================================
# In local development, the Vite dev server automatically proxies '/api' to
# http://localhost:5000. Leaving VITE_API_URL empty or unset uses this proxy.
# In production, set this to the full origin or subpath of your API server.
# Example: https://api.bystander.example.com/api
VITE_API_URL=/api

# Backend proxy target for Vite dev server (optional override)
# VITE_BACKEND_TARGET=http://localhost:5001

# Central Data Layer Mode: 'api-first' (default), 'api-only', or 'static'
# - api-first: API primary with fallback only for approved public read-only catalogs
# - api-only: API is sole source of truth; errors are propagated
# - static: Local development offline simulation using mock data
VITE_DATA_MODE=api-first
